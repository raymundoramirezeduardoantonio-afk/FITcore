<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile"
    android:layout_width="128dp"
    android:layout_height="148dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_surface_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:padding="16dp"
    android:stateListAnimator="@animator/press_scale">

    <View
        android:id="@+id/tileGlow"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-50dp"
        android:layout_marginEnd="-50dp"
        android:background="@drawable/bg_glow_volt" />

    <View
        android:id="@+id/tileDot"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:background="@drawable/bg_circle_volt" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/text_primary"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/tileCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>

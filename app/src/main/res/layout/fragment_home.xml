<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="140dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp">

        <!-- Encabezado -->
        <LinearLayout
            android:id="@+id/homeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMotto"
                    style="@style/FitCore.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hola de nuevo" />

                <TextView
                    android:id="@+id/tvWelcomeName"
                    style="@style/FitCore.Text.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="¡Hola!"
                    android:textSize="30sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_volt"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:stateListAnimator="@animator/press_scale"
                android:text="F"
                android:textColor="@color/black"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- Tarjeta de nivel -->
        <FrameLayout
            android:id="@+id/heroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_hero_gradient"
            android:clipChildren="true"
            android:elevation="0dp">

            <View
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-90dp"
                android:layout_marginEnd="-70dp"
                android:alpha="0.35"
                android:background="@drawable/bg_circle_glass" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FitCore.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_glass"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="Nivel actual"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/tvLevelHome"
                        style="@style/FitCore.Text.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="1"
                        android:textColor="@color/white"
                        android:textSize="72sp" />

                    <TextView
                        android:id="@+id/tvXPNextLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:alpha="0.9"
                        android:text="Cargando progreso…"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="104dp"
                    android:layout_height="104dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/cpLevel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:progress="0"
                        app:indicatorColor="@color/white"
                        app:indicatorSize="104dp"
                        app:trackColor="#33FFFFFF"
                        app:trackCornerRadius="8dp"
                        app:trackThickness="10dp" />

                    <TextView
                        android:id="@+id/tvLevelPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-black"
                        android:text="0%"
                        android:textColor="@color/white"
                        android:textSize="22sp" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Estadísticas -->
        <LinearLayout
            android:id="@+id/statsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_black"
                    android:contentDescription="Racha"
                    android:padding="8dp"
                    android:src="@drawable/ic_fire"
                    app:tint="@color/flame" />

                <TextView
                    android:id="@+id/tvStreakHome"
                    style="@style/FitCore.Text.Number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="0" />

                <TextView
                    style="@style/FitCore.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Días racha"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_black"
                    android:contentDescription="Experiencia"
                    android:padding="8dp"
                    android:src="@drawable/ic_bolt"
                    app:tint="@color/volt" />

                <TextView
                    android:id="@+id/tvXPHome"
                    style="@style/FitCore.Text.Number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="0" />

                <TextView
                    style="@style/FitCore.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="XP total"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_black"
                    android:contentDescription="Entrenamientos"
                    android:padding="8dp"
                    android:src="@drawable/ic_trophy"
                    app:tint="@color/violet" />

                <TextView
                    android:id="@+id/tvWorkoutsHome"
                    style="@style/FitCore.Text.Number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="0" />

                <TextView
                    style="@style/FitCore.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Entrenos"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Semana -->
        <TextView
            android:id="@+id/lblWeek"
            style="@style/FitCore.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Esta semana" />

        <LinearLayout
            android:id="@+id/weekStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_surface_card"
            android:orientation="horizontal"
            android:padding="10dp" />

        <!-- Llamado a la acción -->
        <FrameLayout
            android:id="@+id/btnQuickStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_volt_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:minHeight="128dp"
            android:padding="24dp"
            android:stateListAnimator="@animator/press_scale">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:layout_marginEnd="80dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.14"
                    android:text="TU PRÓXIMO PASO"
                    android:textColor="#99000000"
                    android:textSize="11sp" />

                <TextView
                    style="@style/FitCore.Text.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="0.9"
                    android:text="¿Listo para\nentrenar hoy?"
                    android:textColor="@color/black"
                    android:textSize="26sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/quickStartArrow"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_vertical|end"
                android:background="@drawable/bg_circle_black">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="Ir a entrenar"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/volt" />
            </FrameLayout>
        </FrameLayout>

        <!-- Grupos musculares -->
        <LinearLayout
            android:id="@+id/muscleHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/FitCore.Text.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Explora por músculo" />

            <TextView
                android:id="@+id/tvSeeAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:fontFamily="sans-serif-medium"
                android:padding="6dp"
                android:text="Ver todo →"
                android:textColor="@color/volt"
                android:textSize="13sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/muscleScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-20dp"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="20dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/muscleRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

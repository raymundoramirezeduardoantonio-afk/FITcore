<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FITCORE" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorPrimaryVariant">@color/neon_cyan_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/neon_purple</item>
        <item name="colorSecondaryVariant">@color/neon_purple_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/nav_bar</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorSurface">@color/bg_secondary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/difficulty_advanced</item>
        <item name="colorOnError">@color/white</item>
    </style>

    <style name="FitCoreCardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/divider</item>
    </style>
    <style name="FitCoreSearchView" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:background">@drawable/bg_search</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>
    <style name="FitCoreHeadline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="FitCoreTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="FitCoreBody" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="FitCoreCaption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_accent</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>
    <style name="FitCoreChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/bg_card</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/divider</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">36dp</item>
    </style>
    <style name="FitCoreChip.Active">
        <item name="chipBackgroundColor">@color/neon_cyan</item>
        <item name="chipStrokeColor">@color/neon_cyan</item>
        <item name="android:textColor">@color/black</item>
    </style>
</resources>

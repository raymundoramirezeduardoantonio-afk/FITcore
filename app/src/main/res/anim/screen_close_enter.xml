<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="340"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <translate android:fromXDelta="-8%" android:toXDelta="0" />
    <scale android:fromXScale="0.96" android:toXScale="1" android:fromYScale="0.96" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:fromAlpha="0.4" android:toAlpha="1" />
</set>

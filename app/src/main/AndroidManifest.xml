<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FITCORE">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.FITCORE" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.FITCORE" />

        <activity
            android:name=".ExerciseDetailActivity"
            android:theme="@style/Theme.FITCORE" />

        <activity
            android:name=".ui.routines.CreateRoutineActivity"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FITCORE" />

        <activity
            android:name=".ui.routines.RoutineDetailActivity"
            android:theme="@style/Theme.FITCORE" />

        <activity
            android:name=".ui.routines.AddExerciseToRoutineActivity"
            android:theme="@style/Theme.FITCORE" />

        <activity
            android:name=".WorkoutSessionActivity"
            android:theme="@style/Theme.FITCORE"
            android:screenOrientation="portrait" />

    </application>

</manifest>
